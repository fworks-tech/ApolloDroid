# .env.example
# ============================================================
# Apollo environment variables template.
# Copy this file to .env and fill in your real keys:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to git — it's listed in .gitignore.
# ⚠️  NEVER share your API keys publicly.
# ============================================================

# ---- Picovoice (Wake Word) ----
# Get your free key at: https://console.picovoice.ai/
# After signing up, copy the AccessKey from your dashboard.
PICOVOICE_ACCESS_KEY=your_picovoice_key_here

# ---- Anthropic (Claude API — Apollo's brain) ----
# Get your key at: https://console.anthropic.com/
# Free tier available. Costs ~$0.001 per conversation.
ANTHROPIC_API_KEY=your_anthropic_key_here

# ---- Weather Feature (optional) ----
# Free at: https://openweathermap.org/api
# Required only if you want "Hey Apollo, what's the weather?"
OPENWEATHER_API_KEY=your_openweather_key_here

# ---- Apollo Settings ----
# Name Apollo responds to (used in prompts and TTS greetings)
APOLLO_NAME=Apollo

# Wake word sensitivity: 0.0 (least sensitive) to 1.0 (most sensitive)
# Higher = catches more activations but may have false positives
WAKE_WORD_SENSITIVITY=0.5

# STT language code (e.g. en-US, es-ES, fr-FR)
STT_LANGUAGE=en-US
