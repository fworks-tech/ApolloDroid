# .gitignore
# ============================================================
# Files and folders that should NEVER be committed to git.
# ============================================================

# ---- API Keys & Secrets ----
# ⚠️ These contain private credentials — keep them local only
.env
*.key
*.pem

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# ---- Virtual Environment ----
# Your local Python environment — never commit this (it's huge)
.venv/
venv/
env/
ENV/

# ---- Briefcase Build Outputs ----
# Generated APKs and build artifacts
.briefcase/
android/                        # Briefcase-generated Android project
macOS/
windows/
linux/
*.apk
*.aab

# ---- Wake Word Models ----
# .ppn files are large binary model files — store them separately
# (download instructions are in core/wakeword/README.md)
apollo/core/wakeword/models/*.ppn

# ---- Testing & Coverage ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- OS Artifacts ----
.DS_Store
Thumbs.db
*.swp
*.swo

# ---- IDE ----
.idea/
.vscode/
*.iml
